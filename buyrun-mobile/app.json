{
  "expo": {
    "name": "Buyrun",
    "slug": "buyrun-mobile",
    "owner": "owerworlds-team",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.buyrun.mobile",
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DDFC79",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.buyrun.mobile",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Buyrun · Mobil önizleme",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Davetiyenize bir kapak seçmek için fotoğraflarınıza erişim gerekir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withLocalPreview"
    ],
    "scheme": "buyrun",
    "extra": {
      "eas": {
        "projectId": "4944b7f5-fae5-4e6f-9ae4-356e4a7d13fa"
      }
    }
  }
}
