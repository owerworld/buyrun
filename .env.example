# Üretimde Postgres bağlantısı (Neon, Supabase vb.). Boş bırakılırsa yerelde PGlite (dosya tabanlı) kullanılır.
DATABASE_URL=
# Vercel Cron için gizli anahtar (otomatik silme işi)
CRON_SECRET=
# Sitenin tam adresi (paylaşım linkleri için), örn: https://buyrun.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- İsteğe bağlı: boş kalırsa site yine çalışır, ilgili özellik yedeğe düşer ---

# Davet metnini AI yazsın (console.anthropic.com). Boşsa cevaplara göre hazır metin kullanılır.
ANTHROPIC_API_KEY=
# Varsayılan: claude-opus-5
BUYRUN_AI_MODEL=

# Mekân araması. Sıra: Google → TomTom → OpenStreetMap (anahtarsız, her zaman açık).
# Google Places (New): en geniş kapsam, faturalandırma hesabı ister.
GOOGLE_MAPS_API_KEY=
# TomTom (my.tomtom.com/keys): kart istemez, günde 2.500 arama ücretsiz, kota dolunca ücret kesmez.
TOMTOM_API_KEY=
